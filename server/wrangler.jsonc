{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "logos-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-19",
  "routes": [{ "pattern": "logos-api.rakko.cn", "custom_domain": true }],
  "workers_dev": false,
  "assets": {
    "directory": "./admin-ui/dist",
    "binding": "ASSETS",
    // /v1/* 与 /admin/api/* 永远先进 Worker，其余（/admin/ 管理页）由 Workers Assets 直接返回。
    "run_worker_first": ["/v1/*", "/admin/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "logos-api",
      // 占位：部署前 `wrangler d1 create logos-api` 后填真实 id。
      "database_id": "6355b4e6-46bf-43e9-ba93-69e5aa5022fd",
      "migrations_dir": "migrations"
    }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "USER_QUOTA", "class_name": "UserQuota" },
      { "name": "GLOBAL_QUOTA", "class_name": "GlobalQuota" }
    ]
  },
  // Phainon /auth/me 走 service binding，避免同 zone Worker 互访 custom domain 被拒（1042）。
  "services": [{ "binding": "PHAINON", "service": "phainon" }],
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["UserQuota", "GlobalQuota"] }],
  "vars": {
    "PHAINON_BASE": "https://api.rakko.cn",
    "GLOBAL_MONTHLY_LIMIT_CNY": "200",
    "DEFAULT_MONTHLY_LIMIT_CNY": "10"
  },
  "observability": { "enabled": true }
  // secret: DEEPSEEK_API_KEY（`wrangler secret put DEEPSEEK_API_KEY`）
}
